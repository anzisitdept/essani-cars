# =====================================================================
# Example environment file — placeholders only, NO real secrets here.
# Copy the relevant values into .env.local (gitignored) on the server.
# =====================================================================

# ============ Essani Cars Public Website — server-side Firebase Admin ============
# Used ONLY by the Website module's server routes to manage the public
# website inventory (brands, new cars, used cars) in its own Firebase project.
# Never set these as NEXT_PUBLIC_* values (they must stay server-side).
#
# Get a service account key from:
#   Firebase console -> essani-cars-pk -> Project settings -> Service accounts
#   -> Generate new private key (JSON)
WEBSITE_FIREBASE_PROJECT_ID=essani-cars-pk
WEBSITE_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@essani-cars-pk.iam.gserviceaccount.com
WEBSITE_FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMI...replace-with-service-account-key...\n-----END PRIVATE KEY-----\n
# Tip: keep literal \n sequences if your deployment passes one-liners — the
# server converts them to newlines when initializing the Admin SDK.

# Only needed if the website project's Firestore data lives in a NAMED
# (non-default) database. Leave unset for the regular (default) database.
# WEBSITE_FIREBASE_DATABASE_ID=
